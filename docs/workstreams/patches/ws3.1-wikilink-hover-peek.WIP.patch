@@ -0,0 +1,63 @@
+/* Hover preview for a wikilink target. Tokens only, so every theme carries it. */
+.wikilink-peek {
+  position: fixed;
+  z-index: 60;
+  width: 300px;
+  max-width: calc(100vw - 16px);
+  box-sizing: border-box;
+  padding: 10px 12px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--surface-panel, var(--popover));
+  color: var(--foreground);
+  box-shadow: 0 6px 20px -8px var(--shadow-dialog, transparent);
+  font-size: 12.5px;
+  line-height: 1.45;
+  pointer-events: auto;
+  animation: wikilink-peek-in 120ms ease-out;
+}
+
+.wikilink-peek__title {
+  font-weight: 600;
+  font-size: 13px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.wikilink-peek__meta {
+  margin-top: 2px;
+  color: var(--muted-foreground);
+  font-size: 11.5px;
+}
+
+.wikilink-peek__excerpt {
+  margin: 6px 0 0;
+  color: var(--muted-foreground);
+  display: -webkit-box;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 3;
+  line-clamp: 3;
+  overflow: hidden;
+}
+
+.wikilink-peek[data-kind='missing'] {
+  border-style: dashed;
+}
+
+.wikilink-peek[data-kind='missing'] .wikilink-peek__meta {
+  color: var(--primary);
+}
+
+@keyframes wikilink-peek-in {
+  from {
+    opacity: 0;
+    transform: translateY(2px);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .wikilink-peek {
+    animation: none;
+  }
+}
